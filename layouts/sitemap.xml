{{- /* Sitemap of one language, with the same hreflang alternates as the pages'
       <head> (language codes, x-default = English). lastmod comes from git (last
       commit of the page's file); for the home page, the date of the Airbnb
       reviews (data/reviews.yaml, `updated`) when more recent: they are part of
       its visible content but live outside its file.
       Pages without a URL (blog posts, shown on the blog page) are skipped. */ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
{{- range where .Pages "Sitemap.Disable" "ne" true }}
{{- if .Permalink }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- $lastmod := .Lastmod }}
    {{- if .IsHome }}
      {{- with hugo.Data.reviews.updated }}
        {{- $reviews := time . }}
        {{- if $reviews.After $lastmod }}{{ $lastmod = $reviews }}{{ end }}
      {{- end }}
    {{- end }}
    {{- if not $lastmod.IsZero }}
    <lastmod>{{ $lastmod.Format "2006-01-02" }}</lastmod>
    {{- end }}
    {{- range .AllTranslations }}
    <xhtml:link rel="alternate" hreflang="{{ .Language.Lang }}" href="{{ .Permalink }}" />
    {{- end }}
    {{- range first 1 (where .AllTranslations "Language.Lang" "en") }}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ .Permalink }}" />
    {{- end }}
  </url>
{{- end }}
{{- end }}
</urlset>
