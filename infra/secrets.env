# Proton Pass secret references (not the secrets themselves): safe to commit.
# Used locally with:  pass-cli run --env-file secrets.env -- tofu <command>
# In GitHub Actions the same variables come from repository secrets.
BUNNYNET_API_KEY=pass://LeColRoule/bunny-api-key/password
TF_VAR_state_passphrase=pass://LeColRoule/tofu-state-passphrase/password
INFOMANIAK_TOKEN=pass://LeColRoule/infomaniak-api-token/password
