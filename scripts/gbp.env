# Proton Pass secret references (not the secrets themselves): safe to commit.
# Used locally with:  pass-cli run --env-file scripts/gbp.env -- python3 scripts/gbp_post.py ...
# In GitHub Actions the same variables come from repository secrets.
GBP_CLIENT_ID=pass://LeColRoule/google-client-id/password
GBP_CLIENT_SECRET=pass://LeColRoule/google-client-secret/password
GBP_REFRESH_TOKEN=pass://LeColRoule/google-refresh-token/password
